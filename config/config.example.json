{
  "poll_interval_seconds": 30,
  "data_dir": "/var/lib/opi-dockerd-watch",
  "telegram_bot_token": "123456789:replace_me",
  "telegram_chat_id": "123456789",
  "host_alias": "orangepi-ultra",
  "alert_cooldown_minutes": 20,
  "inspect_failure_threshold": 3,
  "status_failure_threshold": 2,
  "auto_restart_cooldown_minutes": 15,
  "auto_restart_max_attempts": 3,
  "auto_restart_max_backoff_minutes": 120,
  "daily_summary": {
    "enabled": true,
    "hour": 9,
    "minute": 0
  },
  "containers": [
    {
      "name": "tires_backend",
      "display_name": "Tires Backend",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tire-crm-frontend-client-tma-1",
      "display_name": "CRM Client Frontend",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tire-crm-frontend-staff-tma-1",
      "display_name": "CRM Staff Frontend",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tires-minio",
      "display_name": "MinIO",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tires_shop_db",
      "display_name": "Shop DB",
      "required": true,
      "auto_restart": false,
      "max_restart_delta": 1
    },
    {
      "name": "cloudflare_tunnel",
      "display_name": "Cloudflare Tunnel",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tirebot-app",
      "display_name": "Tirebot App",
      "required": true,
      "auto_restart": true,
      "max_restart_delta": 2
    },
    {
      "name": "tirebot-db",
      "display_name": "Tirebot DB",
      "required": true,
      "auto_restart": false,
      "max_restart_delta": 1
    },
    {
      "name": "tires_shop_pgadmin",
      "display_name": "pgAdmin",
      "required": false,
      "auto_restart": false,
      "max_restart_delta": 1
    }
  ]
}
