[Unit]
Description=Orange Pi Docker container watcher
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/opi-dockerd-watch -config /etc/opi-dockerd-watch/config.json
Restart=always
RestartSec=5
User=root
WorkingDirectory=/var/lib/opi-dockerd-watch

[Install]
WantedBy=multi-user.target
